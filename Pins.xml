<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- A glow drawn under a matching map pin. Mouse-disabled: it must never take a click from the pin it marks. -->
	<Frame name="HandyNotesMapSearchPinTemplate" mixin="HandyNotesMapSearchPinMixin" enableMouse="false" virtual="true">
		<Size x="30" y="30"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Glow" atlas="ui-questpoi-outerglow" alphaMode="ADD" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Animations>
			<AnimationGroup parentKey="Pulse" looping="BOUNCE">
				<Alpha childKey="Glow" fromAlpha="0.45" toAlpha="1" duration="0.6" smoothing="IN_OUT"/>
				<Scale childKey="Glow" fromScaleX="1" toScaleX="1.3" fromScaleY="1" toScaleY="1.3" duration="0.6" smoothing="IN_OUT"/>
			</AnimationGroup>
		</Animations>
	</Frame>
</Ui>
